{
	"model": {
		"name": "qwen3.8-flash",
		"baseUrl": "https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1"
	},
	"agents": {
		"builtin": {
			"exploreModel": "qwen3.8-flash"
		},
		"modelGrades": {
			"small": "qwen3.8-flash"
		},
		"allowedGrades": ["small"]
	},
	"mcpServers": {
		"leet": {
			"command": "python",
			"args": [".qwen/mcp/server.py"],
			"cwd": ".",
			"env": {
				"PYTHONUNBUFFERED": "1"
			},
			"timeout": 600000,
			"trust": true,
			"includeTools": [
				"fix_format",
				"statement_check",
				"clone_check",
				"check_tests",
				"run_gen",
				"fill_expected",
				"write_catalog",
				"drop_problem"
			]
		}
	},
	"mcp": {
		"allowed": ["leet"],
		"excluded": ["godot-ai", "blender"]
	},
	"permissions": {
		"deny": ["skill"]
	},
	"$version": 4
}
